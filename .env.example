# ORACLE Bot — env (ISI NILAI ASLI, file ini JANGAN pernah di-commit)

# Telegram (wajib untuk jalankan bot)
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
# chat id yang boleh pakai bot, pisah koma, contoh: 123456789,987654321
ALLOWED_CHAT_IDS=

# LLM chain (fallback order: tokenrouter -> b.ai -> devstack lokal)
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=z-ai/glm-5.3-free

BAI_BASE_URL=https://api.b.ai/v1
BAI_API_KEY=
BAI_MODEL=qwen3.8-flash

DEVSTACK_BASE_URL=http://127.0.0.1:20128/v1
DEVSTACK_API_KEY=
DEVSTACK_MODEL=9router/Dev-Stack

# Opsional
COINGECKO_DEMO_KEY=
TWELVEDATA_API_KEY=

# X (Twitter) read-only session (auth_token + ct0 dari browser setelah login)
X_AUTH_TOKEN=
X_CT0=
X_HANDLE=
